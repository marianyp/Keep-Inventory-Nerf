{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "sources": "${mod_git_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/keepinventorynerf/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.mariany.keepinventorynerf.KeepInventoryNerf"
    ],
    "client": [
      "dev.mariany.keepinventorynerf.client.KeepInventoryNerfClient"
    ],
    "fabric-datagen": [
      "dev.mariany.keepinventorynerf.KeepInventoryNerfDataGenerator"
    ]
  },
  "mixins": [
    "keepinventorynerf.mixins.json"
  ],
  "accessWidener": "keepinventorynerf.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": ">=0.154.2"
  }
}
